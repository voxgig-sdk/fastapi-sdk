# BasicRobotFlow

main: kit: flow: BasicRobotFlow:
{
  entity: "robot",
  kind: "basic",
  name: "BasicRobotFlow",
  step: [
    {
      input: {
        ref: "robot_ref01",
        srcdatavar: "robot_ref01_data",
        suffix: "_dt0"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-robot_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRobotFlow"
}
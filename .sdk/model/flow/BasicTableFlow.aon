# BasicTableFlow

main: kit: flow: BasicTableFlow:
{
  entity: "table",
  kind: "basic",
  name: "BasicTableFlow",
  step: [
    {
      input: {
        ref: "table_ref01",
        srcdatavar: "table_ref01_data",
        suffix: "_dt0"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-table_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTableFlow"
}